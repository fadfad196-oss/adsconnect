# ---------------------------------------------------------------- core
# Public origin of this app. OAuth redirect URIs are built from it and must
# match what you register on each platform, character for character.
APP_URL=http://localhost:3000

# Long random string. Platform tokens are encrypted with a key derived from it,
# so changing it forces every source to reconnect.
APP_SECRET=

# Optional: where the JSON store and the response cache live.
# ADSCONNECT_DATA_DIR=/var/lib/adsconnect

# ------------------------------------------------------------ Google Ads
# Google Cloud OAuth client with the Google Ads API enabled, plus a developer
# token from a Google Ads manager (MCC) account.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
# Manager account id, digits only, when accounts are reached through an MCC.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# GOOGLE_ADS_API_VERSION=v25

# ------------------------------------------------ Google Analytics 4 (GA4)
# Enable the Analytics Data API and the Analytics Admin API on the project.
GOOGLE_ANALYTICS_CLIENT_ID=
GOOGLE_ANALYTICS_CLIENT_SECRET=
# Or share one OAuth client across both Google connectors:
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------- Meta (Facebook, Instagram)
# Business app with the Marketing API product and the ads_read permission.
META_APP_ID=
META_APP_SECRET=
# META_API_VERSION=v26.0

# --------------------------------------------------------------- TikTok Ads
# TikTok for Business developer app with reporting scopes.
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
# Only set this if your account reports a purchase value metric you want mapped
# to the revenue column; an unknown metric name fails the whole report.
# TIKTOK_REVENUE_METRIC=

# ------------------------------------------------------------- LinkedIn Ads
# Requires Marketing Developer Platform access on the app.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# LINKEDIN_API_VERSION=202608

# ------------------------------------------------------------------ Adform
# Client credentials issued by Adform support; there is no user OAuth screen.
ADFORM_CLIENT_ID=
ADFORM_CLIENT_SECRET=
# ADFORM_SCOPE=https://api.adform.com/scope/eapi https://api.adform.com/scope/buyer.stats
# ADFORM_COST_SPEC=gross
